# Trainingo backend environment variables
# Copy this file to backend/.env and fill in your values.

# Required: Groq API key used by backend/main.py for AI curriculum and question generation.
GROQ_API_KEY=your_groq_api_key_here

# SQLite database location.
# This path is based on the project root when running uvicorn backend.main:app.
DATABASE_URL=sqlite:///./backend/trainingo.db

# Optional alternative DB path setting.
# Usually leave this commented out unless database.py is configured to prefer DB_PATH.
# DB_PATH=./backend/trainingo.db
